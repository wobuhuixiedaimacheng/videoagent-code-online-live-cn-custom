# 不要把真实 key 提交到 git，也不要发到聊天里。
# 本地复制一份：cp .env.example .env.local

# 可选：anthropic / openai / custom
# 留空时会按已填写的 key 自动选择；没有 key 时走本地模式。
DEFAULT_PROVIDER=

# 1 = 不调用真实模型，走本地模式；0 = 有 key 时调用真实 API
DEMO_MODE=0

# 1 = 启用真 agent loop + tool use；0 = 使用旧单发 JSON 路径
AGENT_LOOP=0
AGENT_MAX_STEPS=12
AGENT_TOKEN_BUDGET=24000
AGENT_TOOL_RESULT_BUDGET=3000
AGENT_PROVIDER_RETRIES=2

# 下面两个是一对，调一个通常要跟着调另一个：
# 额度调大 → 单次输出更长 → 耗时更久 → 更容易撞上超时。
# 一集三分钟短剧的完整 JSON 大约需要 8000，低于这个数会被截断成半截 JSON。
AGENT_MODEL_MAX_TOKENS=8000
# 单次模型请求的等待上限（毫秒）。慢速中转上生成整集剧本实测 85 秒以上。
AGENT_PROVIDER_TIMEOUT_MS=180000

# 单次输出撞上 max_tokens 时，最多自动续写几轮（默认 3，设 0 关闭）。
# 一集剧本的完整 JSON 不一定装得进单次额度；续写把「装不下」变成「多跑一轮」，
# 而不是让人去猜 AGENT_MODEL_MAX_TOKENS 该设多大。注意每多一轮都要吃 AGENT_PROVIDER_TIMEOUT_MS。
AGENT_CONTINUATION_ROUNDS=3

# 模型吐出语法坏掉的 JSON 时，是否再花一次调用让它自己修（默认开）。
# 只对语法错误生效；截断和空内容不会触发，重修一次也是一样的结果。设为 0 关闭。
AGENT_JSON_REPAIR=1

# 线上环境通过页面保存模型配置时使用的管理口令。
# 本机 localhost 不需要；公网部署建议设置它，不建议直接开放 ALLOW_BROWSER_MODEL_CONFIG。
MODEL_CONFIG_ADMIN_TOKEN=

# 仅限可信内网或临时调试：true = 浏览器可直接写模型配置；false = 强制禁止页面写入。
ALLOW_BROWSER_MODEL_CONFIG=

# 页面里只需要输入一套 API Key + Base URL，然后分别填写文本/图片/视频模型 ID。
# 自定义 OpenAI-compatible API，例如 Agens AI / DeepSeek / 通义 / Moonshot / OpenRouter 等。
# 注意：不同平台的 BASE_URL 和 MODEL 名称不一样，请以对方控制台/文档为准。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# 生图模型：页面统一配置时会复用同一套 API Key + Base URL。
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# 视频模型：页面统一配置时会复用同一套 API Key + Base URL。
VIDEO_PROVIDER=agnes
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=agnes-video-v2.0

# 身份参考图（锁人脸用）挂在 extra_body 的哪个键上。
# 留空 = reference_images，这个键名在 agnes-video-v2.0 上实测可用，正常情况下不用填。
# 这些图和首帧/关键帧是两回事：混进 image 数组会被当成关键帧序列，
# 视频就成了从场景渐变到人脸特写，所以必须走独立的键。
# 换了底层视频模型、上游因为这个字段报 400 时，服务端会自动去掉它重发一次并在界面上
# 说明「本次锁脸未生效」，这时把新模型的正确键名填在这里即可恢复。
VIDEO_IDENTITY_REFERENCE_FIELD=

# 画面质检模型（需要支持读图的多模态模型，例如 gpt-4o / qwen-vl / claude-sonnet）。
# 渲染完成的片段会抽 10 帧送它逐项检查手指、脚趾、穿模、换脸等结构性崩坏，
# 不通过的镜头自动换策略重渲，每个镜头最多 2 次。
# 抽 10 帧而不是 3 帧，是因为脸部抖动是相邻帧之间的变化：3 帧时两帧相隔一秒半，
# 判定模型看到的是三张各自正常的脸，这类问题整段漏检。
# 三项留空 = 关闭质检：片段渲染成功即视为完成，并在卡片上标注「未质检」。
# 留空时会依次回落到 CUSTOM_* 和 OPENAI_* 的配置。
QA_API_KEY=
QA_BASE_URL=
QA_VISION_MODEL=
