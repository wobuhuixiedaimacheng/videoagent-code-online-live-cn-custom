diff --git a/.superpowers/sdd/task-7-before/components/ProductionCanvas.tsx b/components/ProductionCanvas.tsx
index e69de29..bfbe524 100644
--- a/.superpowers/sdd/task-7-before/components/ProductionCanvas.tsx
+++ b/components/ProductionCanvas.tsx
@@ -0,0 +1,61 @@
+import type { ReactNode } from 'react';
+import type { ProductionStageId, ProductionStageStatus } from '../lib/types';
+
+export type ProductionCanvasNode = {
+  id: string;
+  stage: ProductionStageId;
+  title: string;
+  summary: string;
+  status: ProductionStageStatus;
+  itemCount?: number;
+};
+
+type ProductionCanvasProps = {
+  nodes: ProductionCanvasNode[];
+  activeStage: ProductionStageId;
+  nextGeneratingStage: ProductionStageId | null;
+  reviewContent: ReactNode;
+  onSelectNode: (node: ProductionCanvasNode) => void;
+  onRegenerate: (node: ProductionCanvasNode) => void;
+  onReplace: (node: ProductionCanvasNode) => void;
+};
+
+export default function ProductionCanvas({
+  nodes,
+  activeStage,
+  nextGeneratingStage,
+  reviewContent,
+  onSelectNode,
+  onRegenerate,
+  onReplace
+}: ProductionCanvasProps) {
+  return (
+    <section className="production-canvas" aria-label="渐进式视频生产画板">
+      <div className="production-canvas-track">
+        {nodes.map((node) => (
+          <article className={`production-node ${node.status} ${activeStage === node.stage ? 'active' : ''}`} key={node.id}>
+            <button type="button" className="production-node-main" onClick={() => onSelectNode(node)}>
+              <span>{node.stage}</span>
+              <strong>{node.title}</strong>
+              <small>{node.summary}</small>
+              {typeof node.itemCount === 'number' && <em>{node.itemCount} 项</em>}
+            </button>
+            <div className="production-node-actions">
+              <button type="button" onClick={() => onRegenerate(node)} aria-label={`重新生成${node.title}`}>重新生成</button>
+              <button type="button" onClick={() => onReplace(node)} aria-label={`替换${node.title}`}>替换</button>
+            </div>
+          </article>
+        ))}
+        {nextGeneratingStage && (
+          <div className="production-next-skeleton" role="status" aria-live="polite">
+            <span>{nextGeneratingStage}</span>
+            <strong>生成中</strong>
+          </div>
+        )}
+      </div>
+      <section className="production-stage-review" aria-live="polite">
+        {reviewContent}
+      </section>
+    </section>
+  );
+}
